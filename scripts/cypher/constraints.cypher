CREATE CONSTRAINT user_id IF NOT EXISTS FOR (n:User) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT competition_id IF NOT EXISTS FOR (n:Competition) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT kernel_id IF NOT EXISTS FOR (n:Kernel) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT kernel_version_id IF NOT EXISTS FOR (n:KernelVersion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT dataset_id IF NOT EXISTS FOR (n:Dataset) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT dataset_version_id IF NOT EXISTS FOR (n:DatasetVersion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT tag_id IF NOT EXISTS FOR (n:Tag) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT library_id IF NOT EXISTS FOR (n:Library) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT forum_id IF NOT EXISTS FOR (n:Forum) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT forum_topic_id IF NOT EXISTS FOR (n:ForumTopic) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT forum_message_id IF NOT EXISTS FOR (n:ForumMessage) REQUIRE n.id IS UNIQUE;
